@@ -0,0 +1,252 @@
+use std::collections::{HashMap, VecDeque};
+
+use anyhow::Context;
+use uuid::Uuid;
+use wm_common::{TilingDirection, WindowState};
+
+use crate::{
+  commands::{container::set_focused_descendant, window::update_window_state},
+  models::{Container, WindowContainer},
+  traits::{CommonGetters, TilingDirectionGetters, TilingSizeGetters, WindowGetters},
+  user_config::UserConfig,
+  wm_state::WmState,
+};
+
+/// Owned snapshot of topology and proportions, independent of subsequent detaches.
+#[derive(Clone)]
+pub struct LayoutNode {
+  container: Container,
+  size: Option<f32>,
+  direction: Option<TilingDirection>,
+  focus: VecDeque<Uuid>,
+  children: Vec<LayoutNode>,
+}
+
+/// A real minimized group. Workspace identity never changes.
+pub struct MinimizedGroup {
+  layout: LayoutNode,
+  focused: Uuid,
+  windows: Vec<(Uuid, WindowState)>,
+}
+
+impl LayoutNode {
+  /// Capture values instead of relying on mutable container references alone.
+  fn capture(container: &Container) -> Self {
+    Self {
+      container: container.clone(),
+      size: container.as_tiling_container().ok().map(|c| c.tiling_size()),
+      direction: container.as_direction_container().ok().map(|c| c.tiling_direction()),
+      focus: container.borrow_child_focus_order().clone(),
+      children: container.children().iter().map(Self::capture).collect(),
+    }
+  }
+
+  /// Rebuild surviving windows and prune branches whose windows were closed/moved.
+  fn rebuild(&self, windows: &mut HashMap<Uuid, WindowContainer>) -> Option<Container> {
+    if self.container.as_window_container().is_ok() {
+      let window: Container = windows.remove(&self.container.id())?.into();
+      if let (Some(size), Ok(tiling)) = (self.size, window.as_tiling_container()) {
+        tiling.set_tiling_size(size);
+      }
+      return Some(window);
+    }
+    let children: Vec<_> = self.children.iter().filter_map(|c| c.rebuild(windows)).collect();
+    if self.container.is_split() && children.is_empty() { return None; }
+    let parent = self.container.clone();
+    *parent.borrow_children_mut() = children.iter().cloned().collect();
+    *parent.borrow_child_focus_order_mut() = self.focus.iter().copied()
+      .filter(|id| children.iter().any(|c| c.id() == *id)).collect();
+    for child in &children { *child.borrow_parent_mut() = Some(parent.clone()); }
+    if let (Some(size), Ok(tiling)) = (self.size, parent.as_tiling_container()) {
+      tiling.set_tiling_size(size);
+    }
+    if let (Some(direction), Ok(container)) = (&self.direction, parent.as_direction_container()) {
+      container.set_tiling_direction(direction.clone());
+    }
+    normalize_children(&parent);
+    Some(parent)
+  }
+}
+
+/// Normalize remaining shares after a window or an empty branch is removed.
+pub fn normalize_children(parent: &Container) {
+  let children: Vec<_> = parent.tiling_children().collect();
+  let total: f32 = children.iter().map(TilingSizeGetters::tiling_size).sum();
+  if total > 0.0 && (total - 1.0).abs() > 0.000001 {
+    for child in children { child.set_tiling_size(child.tiling_size() / total); }
+  }
+}
+
+/// Remove empty split branches without flattening intentional populated groups.
+pub fn prune_empty_splits(parent: &Container) -> usize {
+  let mut removed = 0;
+  for child in parent.children() {
+    removed += prune_empty_splits(&child);
+    if child.is_split() && !child.has_children() {
+      parent.borrow_children_mut().retain(|c| c.id() != child.id());
+      parent.borrow_child_focus_order_mut().retain(|id| *id != child.id());
+      *child.borrow_parent_mut() = None;
+      removed += 1;
+    }
+  }
+  if removed > 0 { normalize_children(parent); }
+  removed
+}
+
+/// Queue all native minimizes in one IPC operation, preserving the original layout.
+pub fn toggle_minimized_group(state: &mut WmState, config: &UserConfig) -> anyhow::Result<()> {
+  if state.minimized_group.is_some() { return restore_minimized_group(state, config); }
+  let focused = state.focused_container().context("No focused container")?;
+  let workspace = focused.workspace().context("No focused workspace")?;
+  let root: Container = workspace.clone().into();
+  prune_empty_splits(&root);
+  let layout = LayoutNode::capture(&root);
+  let windows: Vec<_> = workspace.descendants().filter_map(|c| c.as_window_container().ok())
+    .filter(|w| w.state() != WindowState::Minimized).collect();
+  if windows.is_empty() { return Ok(()); }
+  let mut saved = Vec::new();
+  for window in windows {
+    state.group_restore_pending.remove(&window.id());
+    // ShowWindowAsync queues the request; no per-window sleep or IPC polling.
+    if let Err(error) = window.native().minimize() {
+      tracing::warn!("Group minimize failed for {}: {error}", window.id());
+      continue;
+    }
+    saved.push((window.id(), window.state()));
+    // Record the accepted desired state before queued OS notifications arrive.
+    window.update_native_properties(|p| p.is_minimized = true);
+    update_window_state(window, WindowState::Minimized, state, config)?;
+  }
+  if saved.is_empty() { return Ok(()); }
+  state.minimized_group = Some(MinimizedGroup { layout, focused: focused.id(), windows: saved });
+  set_focused_descendant(&root, None);
+  state.unmanaged_or_minimized_timestamp = Some(std::time::Instant::now());
+  state.pending_sync.queue_focus_change().queue_workspace_to_reorder(workspace);
+  Ok(())
+}
+
+#[cfg(all(test, target_os = "windows"))]
+mod tests {
+  use super::*;
+  use crate::models::{NativeWindowProperties, SplitContainer, TilingWindow};
+  use wm_common::GapsConfig;
+  use wm_platform::{NativeWindow, NativeWindowWindowsExt, Rect, RectDelta};
+
+  fn split() -> Container {
+    SplitContainer::new(TilingDirection::Horizontal, GapsConfig::default()).into()
+  }
+
+  fn window() -> WindowContainer {
+    let rect = Rect::from_ltrb(0, 0, 800, 600);
+    TilingWindow::new(None, NativeWindow::from_handle(0), NativeWindowProperties {
+      title: String::new(), class_name: String::new(), process_name: String::new(),
+      frame: rect.clone(), is_minimized: false, is_maximized: false,
+      is_resizable: true, shadow_borders: RectDelta::zero(),
+    }, None, RectDelta::zero(), rect, false, GapsConfig::default(), Vec::new(), None).into()
+  }
+
+  fn attach(parent: &Container, child: Container) {
+    *child.borrow_parent_mut() = Some(parent.clone());
+    parent.borrow_child_focus_order_mut().push_back(child.id());
+    parent.borrow_children_mut().push_back(child);
+  }
+
+  #[test]
+  fn redraw_prunes_nested_empty_splits_and_reclaims_space() {
+    let root = split();
+    let empty = split();
+    attach(&empty, split());
+    attach(&root, empty);
+    let live = window();
+    live.as_container().as_tiling_container().unwrap().set_tiling_size(0.6);
+    attach(&root, live.as_container());
+    assert_eq!(prune_empty_splits(&root), 2);
+    assert_eq!(root.child_count(), 1);
+    assert_eq!(root.borrow_child_focus_order().len(), 1);
+    assert_eq!(live.as_container().as_tiling_container().unwrap().tiling_size(), 1.0);
+  }
+
+  #[test]
+  fn snapshot_restores_nested_ids_proportions_and_focus_order() {
+    let root = split();
+    let branch = split();
+    let a = window();
+    let b = window();
+    attach(&root, branch.clone());
+    attach(&branch, a.as_container());
+    attach(&branch, b.as_container());
+    a.as_container().as_tiling_container().unwrap().set_tiling_size(0.3);
+    b.as_container().as_tiling_container().unwrap().set_tiling_size(0.7);
+    let saved = LayoutNode::capture(&root);
+    branch.borrow_children_mut().clear();
+    root.borrow_children_mut().clear();
+    let mut windows = HashMap::from([(a.id(), a.clone()), (b.id(), b.clone())]);
+    saved.rebuild(&mut windows).unwrap();
+    assert!(windows.is_empty());
+    assert_eq!(root.children()[0].id(), branch.id());
+    assert_eq!(branch.children()[0].id(), a.id());
+    assert_eq!(branch.children()[1].id(), b.id());
+    assert_eq!(a.as_container().as_tiling_container().unwrap().tiling_size(), 0.3);
+    assert_eq!(b.as_container().as_tiling_container().unwrap().tiling_size(), 0.7);
+    assert_eq!(*branch.borrow_child_focus_order(), VecDeque::from([a.id(), b.id()]));
+    // A closed window must not leave a ghost branch or lost space.
+    let mut remaining = HashMap::from([(b.id(), b.clone())]);
+    saved.rebuild(&mut remaining).unwrap();
+    assert_eq!(branch.child_count(), 1);
+    assert_eq!(b.as_container().as_tiling_container().unwrap().tiling_size(), 1.0);
+  }
+}
+
+/// Restore states and the exact surviving split tree in a single WM transaction.
+pub fn restore_minimized_group(state: &mut WmState, config: &UserConfig) -> anyhow::Result<()> {
+  let Some(saved) = state.minimized_group.take() else { return Ok(()); };
+  let workspace_id = saved.layout.container.id();
+  let Some(workspace) = state.workspaces().into_iter().find(|w| w.id() == workspace_id) else {
+    return Ok(());
+  };
+  let root: Container = workspace.clone().into();
+  let current: Vec<_> = root.descendants().collect();
+  let mut windows: HashMap<_, _> = current.iter().filter_map(|c| c.as_window_container().ok())
+    .map(|w| (w.id(), w)).collect();
+  for (id, original) in &saved.windows {
+    let window = windows.get(id).cloned();
+    let Some(window) = window else { continue; };
+    if window.state() == WindowState::Minimized {
+      state.group_restore_pending.insert(*id, std::time::Instant::now());
+      // The saved tree supplies insertion positions and sizes. Do not run
+      // ordinary per-window detach/reinsert/resize heuristics only to discard
+      // their results immediately afterwards.
+      if *original == WindowState::Tiling {
+        let non_tiling = window.as_non_tiling_window().context("Invalid minimized window")?;
+        windows.insert(*id, non_tiling.to_tiling(config.value.gaps.clone()).into());
+      } else {
+        window.set_prev_state(WindowState::Minimized);
+        window.set_state(original.clone());
+      }
+    }
+  }
+  // Detach the current tree without the ordinary resize/reinsertion heuristics.
+  for child in current.iter().rev() {
+    *child.borrow_parent_mut() = None;
+    child.borrow_children_mut().clear();
+    child.borrow_child_focus_order_mut().clear();
+  }
+  root.borrow_children_mut().clear();
+  root.borrow_child_focus_order_mut().clear();
+  saved.layout.rebuild(&mut windows);
+  // Windows opened while the group was minimized remain managed and visible.
+  for window in windows.into_values() {
+    let child: Container = window.into();
+    *child.borrow_parent_mut() = Some(root.clone());
+    root.borrow_child_focus_order_mut().push_back(child.id());
+    root.borrow_children_mut().push_back(child);
+  }
+  normalize_children(&root);
+  // platform_sync restores directly to the final rectangle once. In particular,
+  // do not issue SW_RESTORE here before the final placement is available.
+  let focus = root.descendants().find(|c| c.id() == saved.focused).unwrap_or(root.clone());
+  set_focused_descendant(&focus, None);
+  state.unmanaged_or_minimized_timestamp = Some(std::time::Instant::now());
+  state.pending_sync.queue_container_to_redraw(root).queue_workspace_to_reorder(workspace).queue_focus_change();
+  Ok(())
+}
